DB_USER=triage
DB_PASSWORD=triage
CORS_ORIGINS=http://localhost:5173
GEMINI_API_KEY=

# Cada servicio sirve REST y gRPC en su puerto:
# pacientes 8081, evaluacion 8082, cola 8083, ia 8084
# GRPC_CLIENT_PACIENTES=static://localhost:8081
# GRPC_CLIENT_IA=static://localhost:8084
# GRPC_CLIENT_EVALUACION=static://localhost:8082

# Producción (Supabase): Session pooler con la clave puesta
# DATABASE_URL=postgresql://postgres.REF:CLAVE@aws-0-us-west-2.pooler.supabase.com:5432/postgres
