# Local / Docker (contenedor hospital-triaje en puerto 5434)
DB_URL=jdbc:postgresql://localhost:5434/hospital_triaje
DB_USER=triage
DB_PASSWORD=triage
CORS_ORIGINS=http://localhost:5173
GEMINI_API_KEY=

# Puertos por servicio (cada proceso usa el suyo)
# pacientes  REST 8081  gRPC 9081
# evaluacion REST 8082  gRPC 9082
# cola       REST 8083
# ia         REST 8084  gRPC 9084
# GRPC_CLIENT_PACIENTES=static://localhost:9081
# GRPC_CLIENT_IA=static://localhost:9084
# GRPC_CLIENT_EVALUACION=static://localhost:9082

# Render (pegar Internal Database URL del Postgres Hospital_triage)
# DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DATABASE
# CORS_ORIGINS=https://TU-APP.vercel.app
