# ==============================================================================
# Variables de Entorno - Sistema de Microservicios TriageIA
# ==============================================================================

# 1. Base de Datos PostgreSQL Compartida
DB_URL=jdbc:postgresql://localhost:5434/hospital_triaje
DB_USER=triage
DB_PASSWORD=triage

# 2. API Gateway (Puerto Público)
PORT=8080
CORS_ORIGINS=http://localhost:5173,https://clasificador-predictivo-e.vercel.app

# 3. Direcciones Internas de Microservicios (Usadas por el Gateway)
MS_PACIENTES_URL=http://localhost:8081
MS_EVALUACION_URL=http://localhost:8082
MS_COLA_URL=http://localhost:8083
MS_IA_URL=http://localhost:8084

# 4. Clientes gRPC Internos (Comunicación Inter-Servicio)
GRPC_CLIENT_PACIENTES=static://localhost:8081
GRPC_CLIENT_IA=static://localhost:8084
GRPC_CLIENT_EVALUACION=static://localhost:8082
GRPC_NEGOTIATION=plaintext

# 5. Inteligencia Artificial (Google Gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash,gemini-1.5-flash
GEMINI_DAILY_LIMIT=150
GEMINI_PER_MINUTE_LIMIT=6

# 6. Cuenta Inicial del Administrador (Bootstrap)
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=UrgenciasAdmin26

# 7. WhatsApp Cloud API (Opcional - Notificaciones de Proximidad de Turno)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_TEMPLATE=
