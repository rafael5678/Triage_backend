# Web Service en Render: ms-pacientes-auth
# Mismo repo del backend, rama develop. PORT lo pone Render solo.
# Recibe gRPC por la red privada: en Render no puede ser instancia Free.

MODULE=ms-pacientes-auth
GRPC_PORT=9081
DATABASE_URL=postgresql://postgres.REF:CLAVE@aws-0-REGION.pooler.supabase.com:5432/postgres
CORS_ORIGINS=https://TU-FRONTEND.vercel.app
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=cambia-esta-clave
