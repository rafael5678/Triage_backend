# Web Service en Render: ms-evaluacion-triaje
# Misma DATABASE_URL que pacientes y que IA. No crea otra base.
# Los hosts gRPC son la dirección interna de cada servicio en Render:
# Connect -> Internal. Render le agrega un sufijo, por ejemplo ms-pacientes-auth-ab12.

MODULE=ms-evaluacion-triaje
GRPC_PORT=9082
GRPC_CLIENT_PACIENTES=static://DIRECCION-INTERNA-DE-PACIENTES:9081
GRPC_CLIENT_IA=static://DIRECCION-INTERNA-DE-IA:9084
DATABASE_URL=postgresql://postgres.REF:CLAVE@aws-0-REGION.pooler.supabase.com:5432/postgres
CORS_ORIGINS=https://TU-FRONTEND.vercel.app
