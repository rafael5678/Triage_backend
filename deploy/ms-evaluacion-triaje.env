# Web Service en Render: ms-evaluacion-triaje
# Misma DATABASE_URL que pacientes y que IA. No crea otra base.
# Los hosts gRPC son los nombres internos de los otros Web Services.

MODULE=ms-evaluacion-triaje
GRPC_PORT=9082
GRPC_CLIENT_PACIENTES=static://ms-pacientes-auth:9081
GRPC_CLIENT_IA=static://ms-ia-recomendacion:9084
DATABASE_URL=postgres://USUARIO:CLAVE@HOST:5432/hospital_triaje
CORS_ORIGINS=https://TU-FRONTEND.onrender.com
